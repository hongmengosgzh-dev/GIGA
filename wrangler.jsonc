{
  "name": "giga",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "giga-shop",
      "database_id": "替换为你的数据库ID",
      "migrations_dir": "./migrations"
    }
  ]
}